# Copy to .env (or export these variables) and adjust for your machine.
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string
SECURE_COOKIES=false

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=votinginfo

# Leave SMTP_HOST empty to print e-mails (with their links) to the console.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

PASSWORD_TOKEN_TTL_HOURS=24
